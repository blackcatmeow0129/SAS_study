/* 8장 연습문제 */

/* 8.1 */
/*  
: 물소비량과 세탁량사이에 상관관계가 존재하는지

귀무: 물소비량과 세탁량사이에 상관관계가 존재하지 않는다.
대립 : 물소비량과 세탁량사이에 상관관계가 존재한다.

유의수준 : 0.05
*/


data exam8_1;
input id x1 y1;
cards;
1 20 48
2 30 51
3 25 53
4 40 46
5 35 52
6 50 48
7 70 51
8 60 53
9 65 46
10 55 52
;
run;
proc print data=exam8_1;
run;

proc plot data=exam8_1;
plot y1*x1;
run;
/* 근데 상관관계가 존재하는지 모르겠다. 그래도 나름 음의 상관관계가 있다고 하심.*/

proc corr data=exam8_1 pearson spearman;
var x1 y1;
run;

/*  
[결론]


[피어슨 상관계수]
유의확률이 (0.8740)이다. 유의확률이 유의수준보다 ("크",작으)므로 귀무가설을 기각할 수 (있,"없")다.
상관계수 r이 (-0.05781)이므므로 (양,"음",무)의 상관관계가 존재한다고할 수 있다.

=> 물소비량과 세탁량사이에 상관관계가 존재하지 않는다.

[스피어만 상관계수]
유의확률이 (0.7867)이다. 유의확률이 유의수준보다 ("크",작으)므로 귀무가설을 기각할 수 (있,"없")다.
상관계수 r이 (-0.09847)이므므로 (양,"음",무)의 상관관계가 존재한다고할 수 있다. 

=> 물소비량과 세탁량사이에 상관관계가 존재하지 않는다.

*/









/* 8.2 */
/*  
: 은행에서 홍보비용이 예금유치액에 미치는 영향을 알아보기 위해

귀무 : 홍보비용과 예금유치액의 상관관계가 존재하지 않는다.
대립 : 홍보비용과 예금유치액의 상관관계가 존재한다. 

홍보비용 : x2
예금유치액 : y2
유의수준 : 0.05

*/


data ex8_2;
input id x2 y2;
cards;
1 40 87
2 50 108
3 30 69
4 60 135
5 70 148
6 60 132
7 30 73
8 60 128
9 20 50
10 80 170
;
run;

proc plot data=ex8_2;
plot y2*x2;
run;

/*  
다음 plot이미지를 통해 보았을 때, 산점도는 오른쪽으로 갈수록 비례하는 우상향의 경향(양의 상관관계)을 보입니다.
*/

proc corr data=ex8_2 pearson;
var y2  x2;
run;

/*  
[피어슨 상관계수]
유의확률이 (<.0001)이다. 유의확률이 유의수준 0.05보다 작으므로 귀무가설을 기각할 수 있다.
상관계수 r이 (0.99780)이므므로 양의 상관관계가 존재한다고할 수 있다.

그러므로 홍보비용이 예금유치액에 영향을 미친다고 볼 수 있다. (홍보비용과 예금유치액은 비례하는 상관관계를 가짐)
*/

