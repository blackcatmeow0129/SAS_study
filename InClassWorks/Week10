/* 
[ iq 프로그램의 효과 분석 ]
귀무 : 프로그램의 효과가 없다.
대립 : 프로그램의 효과가 있다.
유의수준 : 0.05

*/

proc ttest data=d;
	paired iq1*iq2;
run;

/* 표본이 30개 미만이므로, 정규성검정을 해야함. */

proc univariate normal plot;
	var diff;
run;

/* s-w 검정 만족 + 귀무가설을 기각하므로, 프로그램의 효과가 있다. */

proc ttest data=d h0=0;
var diff;
run;

